# Copy to .env and fill in. Both keys are FREE, no credit card needed.
# Gemini: https://aistudio.google.com/apikey    Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: force a provider ("gemini" or "groq"). Default: whichever key is set (Gemini first).
# AGENTX_PROVIDER=gemini

# Optional: override models (Groq retires/blocks models)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Port for web server (Render sets PORT automatically)
# PORT=5000

# Optional: OpenWeatherMap API key for live weather data (if omitted, manual inputs are used)
# OPENWEATHER_API_KEY=

# Folder with theme data files. Defaults to ./data.
# AGENTX_DATA_DIR=./data
